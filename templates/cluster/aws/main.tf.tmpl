terraform {
  required_version = ">= 1.10"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "{{ .Region }}"
}

module "cluster" {
  source = "../../modules/aws/eks-cluster"

  name      = "{{ .Name }}"
  region    = "{{ .Region }}"
  node_size = "{{ .NodeSize }}"
  min_nodes = {{ .MinNodes }}
  max_nodes = {{ .MaxNodes }}
}
